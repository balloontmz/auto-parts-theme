{% comment %}
  Brand logo strip: a grid of brand images with optional links.
  Merchants add brands as blocks in the theme editor.
{% endcomment %}

{%- style -%}
  .brand-logos--{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .brand-logos--{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .brand-logos--{{ section.id }} .brand-logos__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ section.settings.spacing }}px;
  }
  @media screen and (min-width: 750px) {
    .brand-logos--{{ section.id }} .brand-logos__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    }
  }
  .brand-logos--{{ section.id }} .brand-logos__item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.6rem;
    background: rgb(var(--color-background));
    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: var(--media-radius, 0);
  }
  .brand-logos--{{ section.id }} .brand-logos__item img {
    max-width: 100%;
    height: auto;
    {% if section.settings.logo_height > 0 %}
      max-height: {{ section.settings.logo_height }}px;
      width: auto;
    {% endif %}
  }
{%- endstyle -%}

<div class="brand-logos brand-logos--{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="brand-logos__grid" role="list">
      {%- for block in section.blocks -%}
        <div class="brand-logos__item" role="listitem" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" aria-label="{{ block.settings.name | default: block.settings.image.alt | default: 'brand' | escape }}">
          {%- endif -%}
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.image.alt }}
          {%- else -%}
            <span class="caption-large">{{ block.settings.name | escape }}</span>
          {%- endif -%}
          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brand logos",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Shop by brand",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 5
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Logo max height",
      "info": "0 = natural size",
      "default": 48
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 4,
      "max": 32,
      "step": 4,
      "unit": "px",
      "label": "Grid spacing",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": false,
      "label": "Full width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Brand name",
          "info": "Used as text when no image is set, and for accessibility."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Brand logos",
      "blocks": [
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" }
      ]
    }
  ]
}
{% endschema %}
