{% comment %}
  Renders the "shopping for <vehicle>" chip on collection / search pages.
  Visibility is managed by assets/fitment.js.
  Usage: {% render 'fitment-status' %}
{% endcomment %}

<div class="fitment-status" data-fitment-status hidden>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M5 11l1.5-4.2A2 2 0 0 1 8.4 5.5h7.2a2 2 0 0 1 1.9 1.3L19 11" />
    <path d="M4 11h16a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1" />
    <path d="M3 12v3a1 1 0 0 0 1 1h1" />
    <circle cx="7" cy="17" r="1.8" />
    <circle cx="17" cy="17" r="1.8" />
  </svg>
  <span data-fitment-status-label></span>
  <button type="button" class="fitment-status__clear" data-fitment-clear>
    {{ 'fitment.clear' | t }}
  </button>
</div>
